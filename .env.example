# ---- Core ----
DATABASE_URL=postgresql://litellm:CHANGE_ME@postgres:5432/litellm
POSTGRES_PASSWORD=CHANGE_ME

# ---- LiteLLM ----
# Generate a strong master key: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-strong-master-key
# SALT must be STABLE across restarts or existing virtual keys become invalid
LITELLM_SALT_KEY=sk-salt-key-keep-this-stable

# ---- Upstream model providers ----
NVIDIA_NIM_API_KEY_1=
NVIDIA_NIM_API_KEY_2=
NVIDIA_NIM_API_KEY_3=
NVIDIA_NIM_API_KEY_4=
OPENCODE_GO_API_KEY=

# ---- Console auth (better-auth) ----
AUTH_SECRET=choose-a-long-random-secret

# ---- Resend (email verification) ----
RESEND_API_KEY=

# ---- Razorpay (subscription billing — mirrors CrawlMind) ----
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_HOBBY_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_ENTERPRISE_PLAN_ID=

# ---- QStash (scheduled usage-sync worker) ----
QSTASH_TOKEN=
USAGE_SYNC_SECRET=set-a-secret-or-DISABLE_QSTASH_AUTH=1-in-dev

# ---- Public app URL ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
